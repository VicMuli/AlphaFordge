+} from 'lucide-react';
+
+interface MarketSymbol {
+  key: string;
+  name: string;
+  customName: string;
+  category: string;
+  pipSize: number;
+  digits: number;
+  fromDate: string;
+  toDate: string;
+  coverage: string;
+  installed: boolean;
+  installedName: string;
+  isActive: boolean;
+}
+
+export default function MarketData({ config, onUpdateConfig }: { config: any; onUpdateConfig?: (cfg: any) => void }) {
+  const [symbols, setSymbols] = useState<MarketSymbol[]>([]);
+  const [terminalDataDir, setTerminalDataDir] = useState<string>('');
+  const [customHistoryPath, setCustomHistoryPath] = useState<string>('');
+  const [installedCount, setInstalledCount] = useState<number>(0);
+  const [activeSymbol, setActiveSymbol] = useState<string>(config?.symbol || 'USDJPY Dukascopy');
+  const [loading, setLoading] = useState(false);
+  const [categoryFilter, setCategoryFilter] = useState<string>('All');
+  const [searchQuery, setSearchQuery] = useState<string>('');
+  const [feedbackMsg, setFeedbackMsg] = useState<string | null>(null);
+
+  const fetchMarketData = async () => {
+    setLoading(true);
+    try {
+      const res = await fetch('/api/market-data');
+      if (res.ok) {
+        const data = await res.json();
+        setSymbols(data.symbols || []);
+        setTerminalDataDir(data.terminalDataDir || '');
+        setCustomHistoryPath(data.customHistoryPath || '');
+        setInstalledCount((data.installedCustomSymbols || []).length);
+        if (data.activeSymbol) setActiveSymbol(data.activeSymbol);
+      }
+    } catch (e) {
+      console.error('Error fetching market data:', e);
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  useEffect(() => {
+    fetchMarketData();
+  }, [config]);
+
+  const handleSetActive = async (sym: MarketSymbol) => {
+    const newConfig = {
+      ...config,
+      symbol: sym.customName,
+      symbol_key: sym.key,
+      pip_size: String(sym.pipSize),
+    };
+
+    try {
+      const res = await fetch('/api/config', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(newConfig),
+      });
+      if (res.ok) {
+        setActiveSymbol(sym.customName);
+        setSymbols(prev => prev.map(s => ({
+          ...s,
+          isActive: s.key === sym.key
+        })));
+        setFeedbackMsg(`✔ Active Symbol set to ${sym.customName} (Pip: ${sym.pipSize})`);
+        setTimeout(() => setFeedbackMsg(null), 4000);
+        if (onUpdateConfig) onUpdateConfig(newConfig);
+      }
+    } catch (e) {
+      console.error(e);
+    }
+  };
+
+  const filteredSymbols = symbols.filter(s => {
+    const matchesCat = categoryFilter === 'All' || s.category === categoryFilter;
+    const matchesSearch = s.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
+                          s.customName.toLowerCase().includes(searchQuery.toLowerCase()) ||
+                          s.category.toLowerCase().includes(searchQuery.toLowerCase());
+    return matchesCat && matchesSearch;
+  });
+
+  const categories = ['All', 'FX Major', 'FX Cross', 'Commodities', 'Crypto', 'Indices'];
+
+  return (
+    <div className="flex flex-col h-full space-y-4">
+      <SectionHeader 
+        title="🌐 Market Data & Symbol Manager" 
+        subtitle="Inspect MT5 historical datasets, verify 2013-2026 Dukascopy coverage, and manage custom symbols" 
+      />
+
+      {feedbackMsg && (
+        <div className="p-3 bg-emerald-950/80 border border-emerald-600/50 rounded-lg text-emerald-300 text-xs font-semibold flex items-center justify-between">
+          <div className="flex items-center gap-2">
+            <CheckCircle2 size={16} />
+            <span>{feedbackMsg}</span>
+          </div>
+          <span className="text-[11px] text-emerald-400 font-mono">config.json updated</span>
+        </div>
+      )}
+
+      {/* Overview Status Cards */}
+      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
+        <Card className="p-4 bg-[#161f30] border border-[#2d3748]">
+          <div className="flex items-center justify-between mb-2">
+            <span className="text-[11px] font-semibold text-[#8b95a6] uppercase tracking-wider">
+              MT5 Data Directory
+            </span>
+            <Database size={16} className="text-amber-400" />
+          </div>
+          <div className="text-xs font-mono text-gray-200 truncate select-all" title={terminalDataDir}>
+            {terminalDataDir || 'Default Local Path'}
+          </div>
+          <div className="mt-2 flex items-center gap-2 text-[11px] text-emerald-400">
+            <CheckCircle2 size={13} />
+            <span>Terminal bases configured</span>
+          </div>
+        </Card>
+
+        <Card className="p-4 bg-[#161f30] border border-[#2d3748]">
+          <div className="flex items-center justify-between mb-2">
+            <span className="text-[11px] font-semibold text-[#8b95a6] uppercase tracking-wider">
